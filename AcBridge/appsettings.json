{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:5080" }
    }
  },
  "Telemetry": {
    "Source": "Auto",
    "PollHz": 60,
    "DefaultStreamHz": 30,
    "MaxStreamHz": 60,
    "MiniSectors": 24
  }
}
